{
  "name": "shoplab",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node scripts/local-dev.mjs",
    "build": "pnpm --filter @shoplab/web build",
    "db:generate": "pnpm --filter @shoplab/api exec prisma generate",
    "test": "node scripts/test-local.mjs",
    "test:unit": "pnpm --filter @shoplab/api test:unit",
    "test:ui": "playwright test",
    "docs:api": "node scripts/generate-api-docs.mjs"
  },
  "devDependencies": {"embedded-postgres": "18.4.0-beta.17", "@playwright/test": "^1.58.0"}
}
